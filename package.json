{
  "name": "business-primitives",
  "private": true,
  "description": "Eristack Business Primitives monorepo",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "skills:list": "intent list",
    "skills:validate": "node scripts/skills-validate.mjs",
    "docs:sync": "pnpm eristack sync docs",
    "docs:check": "pnpm eristack sync docs --check",
    "knowledge:sync": "pnpm eristack sync knowledge",
    "knowledge:check": "pnpm eristack sync knowledge --check",
    "exports:check": "node scripts/check-package-exports.mjs",
    "changesets:check": "node scripts/check-changesets.mjs",
    "ticket:check": "pnpm --filter @eristack/ai-ticket-generator run check",
    "eristack": "node scripts/eristack-run.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm knowledge:sync && pnpm install --lockfile-only",
    "release": "changeset publish",
    "ci": "pnpm build && pnpm eristack check --profile full --skip-build",
    "web": "pnpm --filter @eristack/web dev"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eristack/abac": "workspace:*",
    "@eristack/ai-dev": "workspace:*",
    "@eristack/ai-knowledge": "workspace:*",
    "@eristack/ai-ticket-generator": "workspace:*",
    "@eristack/ai-workflow": "workspace:*",
    "@eristack/backseat": "workspace:*",
    "@eristack/data-grid": "workspace:*",
    "@eristack/doc-number": "workspace:*",
    "@eristack/epoch": "workspace:*",
    "@eristack/financial-ledger": "workspace:*",
    "@eristack/hash-chained-ledger": "workspace:*",
    "@eristack/jwt-auth": "workspace:*",
    "@eristack/money": "workspace:*",
    "@eristack/timestamp": "workspace:*",
    "@eristack/multitab": "workspace:*",
    "@eristack/pbac": "workspace:*",
    "@eristack/qups": "workspace:*",
    "@eristack/rbac": "workspace:*",
    "@eristack/stock-movement": "workspace:*",
    "@eristack/valuations": "workspace:*",
    "@tanstack/intent": "^0.3.6",
    "turbo": "^2.5.4",
    "typescript": "catalog:"
  },
  "intent": {
    "skills": [
      "workspace:@eristack/money",
      "workspace:@eristack/timestamp",
      "workspace:@eristack/doc-number",
      "workspace:@eristack/qups",
      "workspace:@eristack/stock-movement",
      "workspace:@eristack/financial-ledger",
      "workspace:@eristack/valuations",
      "workspace:@eristack/data-grid",
      "workspace:@eristack/jwt-auth",
      "workspace:@eristack/epoch",
      "workspace:@eristack/rbac",
      "workspace:@eristack/abac",
      "workspace:@eristack/pbac",
      "workspace:@eristack/hash-chained-ledger",
      "workspace:@eristack/backseat",
      "workspace:@eristack/multitab",
      "workspace:@eristack/ai-dev",
      "workspace:@eristack/ai-knowledge",
      "workspace:@eristack/ai-workflow",
      "workspace:@eristack/ai-ticket-generator"
    ]
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "license": "MIT"
}
