{
  "name": "business-primitives",
  "private": true,
  "description": "Eristack Business Primitives monorepo",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "skills:list": "intent list",
    "skills:validate": "node scripts/skills-validate.mjs",
    "docs:sync": "pnpm eristack sync docs",
    "docs:check": "pnpm eristack sync docs --check",
    "knowledge:sync": "pnpm eristack sync knowledge",
    "knowledge:check": "pnpm eristack sync knowledge --check",
    "exports:check": "node scripts/check-package-exports.mjs",
    "publish:check": "node scripts/check-publish-deps.mjs",
    "debottleneck:check": "node scripts/package-debottleneck-check.mjs",
    "debottleneck:check:ci": "node scripts/package-debottleneck-check.mjs --ci",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "changesets:check": "node scripts/check-changesets.mjs",
    "ticket:check": "pnpm exec turbo run build --filter=@eristack/ai-ticket-generator --output-logs=errors-only && pnpm --filter @eristack/ai-ticket-generator run check",
    "ticket:triage": "node scripts/ticket-triage.mjs",
    "backseat:routes:check": "node scripts/backseat-routes-check.mjs check",
    "backseat:routes:diff": "node scripts/backseat-routes-check.mjs diff",
    "eristack": "node scripts/eristack-run.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm knowledge:sync && pnpm install --lockfile-only",
    "release": "changeset publish",
    "ci": "pnpm build && pnpm eristack check --profile full --skip-build",
    "ci:pr": "pnpm --filter @eristack/ai-dev build && pnpm eristack ci --base origin/main",
    "ci:affected": "pnpm --filter @eristack/ai-dev build && pnpm eristack ci --base origin/main --affected",
    "ci:drift": "pnpm eristack check --profile catalog --skip-build",
    "lockfile:check": "node scripts/lockfile-check.mjs",
    "lockfile:sync": "node scripts/lockfile-sync.mjs",
    "prepush": "pnpm ci:affected",
    "web": "pnpm --filter @eristack/web dev"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eristack/abac": "workspace:*",
