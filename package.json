{
  "name": "business-primitives",
  "private": true,
  "description": "Eristack Business Primitives monorepo",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "skills:list": "intent list",
    "skills:validate": "intent validate packages/primitive/money && intent validate packages/capability/doc-number && intent validate packages/service/data-grid && intent validate packages/service/jwt-auth && intent validate packages/service/rbac && intent validate packages/service/abac && intent validate packages/service/pbac && intent validate packages/ai/ai-knowledge && intent validate packages/ai/ai-workflow && intent validate packages/ai/ai-ticket-generator",
    "knowledge:sync": "pnpm --filter @eristack/ai-knowledge sync",
    "knowledge:check": "pnpm --filter @eristack/ai-knowledge sync:check",
    "ticket:check": "pnpm --filter @eristack/ai-ticket-generator run check",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "changeset publish",
    "ci": "pnpm build && pnpm typecheck && pnpm test && pnpm skills:validate && pnpm knowledge:check && pnpm ticket:check",
    "web": "pnpm --filter @eristack/web dev"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eristack/abac": "workspace:*",
    "@eristack/ai-knowledge": "workspace:*",
    "@eristack/ai-ticket-generator": "workspace:*",
    "@eristack/ai-workflow": "workspace:*",
    "@eristack/data-grid": "workspace:*",
    "@eristack/doc-number": "workspace:*",
    "@eristack/jwt-auth": "workspace:*",
    "@eristack/money": "workspace:*",
    "@eristack/pbac": "workspace:*",
    "@eristack/rbac": "workspace:*",
    "@tanstack/intent": "^0.3.6",
    "turbo": "^2.5.4",
    "typescript": "catalog:"
  },
  "intent": {
    "skills": [
      "workspace:@eristack/money",
      "workspace:@eristack/doc-number",
      "workspace:@eristack/data-grid",
      "workspace:@eristack/jwt-auth",
      "workspace:@eristack/rbac",
      "workspace:@eristack/abac",
      "workspace:@eristack/pbac",
      "workspace:@eristack/ai-knowledge",
      "workspace:@eristack/ai-workflow",
      "workspace:@eristack/ai-ticket-generator"
    ]
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
