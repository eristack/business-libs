{
  "name": "business-primitives",
  "private": true,
  "description": "Eristack Business Primitives monorepo",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "skills:list": "intent list",
    "skills:validate": "intent validate packages/money && intent validate packages/jwt-auth && intent validate packages/doc-number",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "changeset publish",
    "ci": "pnpm build && pnpm typecheck && pnpm test && pnpm skills:validate",
    "web": "pnpm --filter @eristack/web dev"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eristack/doc-number": "workspace:*",
    "@eristack/jwt-auth": "workspace:*",
    "@eristack/money": "workspace:*",
    "@tanstack/intent": "^0.3.6",
    "turbo": "^2.5.4",
    "typescript": "catalog:"
  },
  "intent": {
    "skills": [
      "workspace:@eristack/money",
      "workspace:@eristack/jwt-auth",
      "workspace:@eristack/doc-number"
    ]
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
