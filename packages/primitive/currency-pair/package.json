{
  "name": "@eristack/currency-pair",
  "version": "0.0.0",
  "description": "Base/quote currency pair validation and canonical pair keys — no FX rates",
  "repository": {
    "type": "git",
    "url": "https://github.com/eristack/business-libs.git",
    "directory": "packages/primitive/currency-pair"
  },
  "homepage": "https://github.com/eristack/business-libs/tree/main/packages/primitive/currency-pair",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./zod": {
      "import": {
        "types": "./dist/zod/index.d.ts",
        "default": "./dist/zod/index.js"
      },
      "require": {
        "types": "./dist/zod/index.d.ts",
        "default": "./dist/zod/index.cjs"
      }
    }
  },
  "files": ["dist", "docs", "README.md", "skills", "LICENSE"],
  "keywords": ["tanstack-intent", "fx", "currency-pair", "erp", "eristack"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@eristack/money": "workspace:*"
  },
  "peerDependencies": { "zod": "^4.0.0" },
  "peerDependenciesMeta": { "zod": { "optional": true } },
  "devDependencies": {
    "@tanstack/intent": "^0.3.6",
    "@types/node": "^22.15.29",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.10",
    "zod": "^4.0.0"
  },
  "license": "MIT"
}
