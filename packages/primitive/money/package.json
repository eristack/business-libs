{
  "name": "@eristack/money",
  "version": "0.2.1",
  "description": "Money primitives for Eristack",
  "repository": {
    "type": "git",
    "url": "https://github.com/eristack/business-libs.git",
    "directory": "packages/primitive/money"
  },
  "homepage": "https://github.com/eristack/business-libs/tree/main/packages/primitive/money",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "skills",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@tanstack/intent": "^0.3.6",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "decimal.js": "^10.6.0"
  },
  "keywords": [
    "tanstack-intent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
