{
  "name": "@eristack/ai-ticket-generator",
  "version": "0.1.2",
  "description": "Generate portable maintainer tickets (bugs + suggestions) for every @eristack package — logs, scenario, fix plan, and agent-ready handoff files",
  "repository": {
    "type": "git",
    "url": "https://github.com/eristack/business-libs.git",
    "directory": "packages/ai/ai-ticket-generator"
  },
  "homepage": "https://github.com/eristack/business-libs/tree/main/packages/ai/ai-ticket-generator",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "eristack-ticket": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "skills",
    "templates",
    "LICENSE"
  ],
  "keywords": [
    "tanstack-intent",
    "ai",
    "tickets",
    "support",
    "eristack"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node ../../../scripts/chmod-bins.mjs dist/cli.js",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node ./dist/cli.js check",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@tanstack/intent": "^0.3.6",
    "@types/node": "^22.15.29",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}
