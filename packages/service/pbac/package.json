{
  "name": "@eristack/pbac",
  "version": "0.1.0",
  "description": "Policy-based (software) access control for Eristack: business document rules that return true or false",
  "repository": {
    "type": "git",
    "url": "https://github.com/eristack/business-libs.git",
    "directory": "packages/service/pbac"
  },
  "homepage": "https://github.com/eristack/business-libs/tree/main/packages/service/pbac",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express/index.d.ts",
        "default": "./dist/express/index.js"
      },
      "require": {
        "types": "./dist/express/index.d.ts",
        "default": "./dist/express/index.cjs"
      }
    },
    "./nest": {
      "import": {
        "types": "./dist/nest/index.d.ts",
        "default": "./dist/nest/index.js"
      },
      "require": {
        "types": "./dist/nest/index.d.ts",
        "default": "./dist/nest/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./backseat": {
      "import": {
        "types": "./dist/backseat/index.d.ts",
        "default": "./dist/backseat/index.js"
      },
      "require": {
        "types": "./dist/backseat/index.d.ts",
        "default": "./dist/backseat/index.cjs"
      }
    },
    "./backseat/store": {
      "import": {
        "types": "./dist/backseat/store/index.d.ts",
        "default": "./dist/backseat/store/index.js"
      },
      "require": {
        "types": "./dist/backseat/store/index.d.ts",
        "default": "./dist/backseat/store/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "skills"
  ],
  "keywords": [
    "tanstack-intent",
    "pbac",
    "policy",
    "business-rules",
    "eristack"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "express": "^4.0.0 || ^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "@eristack/backseat": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@eristack/backseat": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.12",
    "@nestjs/core": "^11.0.12",
    "@tanstack/intent": "^0.3.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.29",
    "@types/react": "^19.0.0",
    "express": "^5.0.0",
    "react": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.10",
    "@eristack/backseat": "workspace:*"
  }
}
