{
  "name": "@eristack/qups",
  "version": "0.2.0",
  "description": "Quantity / unit price / subtotal (QUPS) with 2-of-3 sources of truth, plus modifiers and tax — business line pricing on @eristack/money",
  "repository": {
    "type": "git",
    "url": "https://github.com/eristack/business-libs.git",
    "directory": "packages/capability/qups"
  },
  "homepage": "https://github.com/eristack/business-libs/tree/main/packages/capability/qups",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./drizzle": {
      "import": {
        "types": "./dist/drizzle/index.d.ts",
        "default": "./dist/drizzle/index.js"
      },
      "require": {
        "types": "./dist/drizzle/index.d.ts",
        "default": "./dist/drizzle/index.cjs"
      }
    },
    "./backseat": {
      "import": {
        "types": "./dist/backseat/index.d.ts",
        "default": "./dist/backseat/index.js"
      },
      "require": {
        "types": "./dist/backseat/index.d.ts",
        "default": "./dist/backseat/index.cjs"
      }
    },
    "./backseat/store": {
      "import": {
        "types": "./dist/backseat/store/index.d.ts",
        "default": "./dist/backseat/store/index.js"
      },
      "require": {
        "types": "./dist/backseat/store/index.d.ts",
        "default": "./dist/backseat/store/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "skills",
    "LICENSE"
  ],
  "keywords": [
    "tanstack-intent",
    "qups",
    "pricing",
    "quantity",
    "discount",
    "tax",
    "money",
    "drizzle",
    "eristack"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@eristack/money": "workspace:*",
    "decimal.js": "^10.6.0"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.39.0 || ^0.40.0 || ^0.41.0 || ^0.42.0 || ^0.43.0 || ^0.44.0",
    "@eristack/backseat": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "@eristack/backseat": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/intent": "^0.3.6",
    "drizzle-orm": "^0.44.0",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.10",
    "@eristack/backseat": "workspace:*"
  },
  "license": "MIT"
}
