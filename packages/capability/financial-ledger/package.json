{
  "name": "@eristack/financial-ledger",
  "version": "0.2.2",
  "description": "Accounting ledger on hash-chained-ledger keyed by accountId, amounts via @eristack/money",
  "repository": {
    "type": "git",
    "url": "https://github.com/eristack/business-libs.git",
    "directory": "packages/capability/financial-ledger"
  },
  "homepage": "https://github.com/eristack/business-libs/tree/main/packages/capability/financial-ledger",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./drizzle": {
      "import": {
        "types": "./dist/drizzle/index.d.ts",
        "default": "./dist/drizzle/index.js"
      },
      "require": {
        "types": "./dist/drizzle/index.d.ts",
        "default": "./dist/drizzle/index.cjs"
      }
    },
    "./backseat": {
      "import": {
        "types": "./dist/backseat/index.d.ts",
        "default": "./dist/backseat/index.js"
      },
      "require": {
        "types": "./dist/backseat/index.d.ts",
        "default": "./dist/backseat/index.cjs"
      }
    },
    "./backseat/store": {
      "import": {
        "types": "./dist/backseat/store/index.d.ts",
        "default": "./dist/backseat/store/index.js"
      },
      "require": {
        "types": "./dist/backseat/store/index.d.ts",
        "default": "./dist/backseat/store/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "skills",
    "LICENSE"
  ],
  "keywords": [
    "tanstack-intent",
    "accounting",
    "ledger",
    "money",
    "eristack"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@eristack/hash-chained-ledger": "^0.1.0",
    "@eristack/money": "^0.3.0",
    "drizzle-orm": "^0.39.0 || ^0.40.0 || ^0.41.0 || ^0.42.0 || ^0.43.0 || ^0.44.0",
    "@eristack/backseat": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "@eristack/backseat": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/intent": "^0.3.6",
    "@types/node": "^22.15.29",
    "drizzle-orm": "^0.44.0",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.10",
    "@eristack/backseat": "workspace:*",
    "@eristack/hash-chained-ledger": "workspace:*",
    "@eristack/money": "workspace:*",
    "@internal/test-harness": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^11.10.0"
  },
  "license": "MIT"
}
