{
  "name": "@eristack/form-ui",
  "version": "0.0.0",
  "description": "Native React form controls wired to @eristack money, percent, and timestamp",
  "repository": {
    "type": "git",
    "url": "https://github.com/eristack/business-libs.git",
    "directory": "packages/ui/form-ui"
  },
  "homepage": "https://github.com/eristack/business-libs/tree/main/packages/ui/form-ui",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist", "docs", "README.md", "skills", "LICENSE"],
  "keywords": ["tanstack-intent", "react", "forms", "money", "eristack"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@eristack/design-system": "^0.0.0",
    "@eristack/money": "^0.3.0",
    "@eristack/percent": "^0.1.0",
    "@eristack/timestamp": "^0.1.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eristack/design-system": "workspace:*",
    "@eristack/money": "workspace:*",
    "@eristack/percent": "workspace:*",
    "@eristack/timestamp": "workspace:*",
    "@tanstack/intent": "^0.3.6",
    "@types/node": "^22.15.29",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}
