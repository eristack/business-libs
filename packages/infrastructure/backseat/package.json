{
  "name": "@eristack/backseat",
  "version": "0.1.7",
  "description": "Frontend mock backend engine: in-browser REST server with pluggable store, controllers, and TanStack Query hooks",
  "repository": {
    "type": "git",
    "url": "https://github.com/eristack/business-libs.git",
    "directory": "packages/infrastructure/backseat"
  },
  "homepage": "https://github.com/eristack/business-libs/tree/main/packages/infrastructure/backseat",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./store": {
      "import": {
        "types": "./dist/store/index.d.ts",
        "default": "./dist/store/index.js"
      },
      "require": {
        "types": "./dist/store/index.d.ts",
        "default": "./dist/store/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./seeds": {
      "import": {
        "types": "./dist/seeds/index.d.ts",
        "default": "./dist/seeds/index.js"
      },
      "require": {
        "types": "./dist/seeds/index.d.ts",
        "default": "./dist/seeds/index.cjs"
      }
    },
    "./adapters": {
      "import": {
        "types": "./dist/adapters/index.d.ts",
        "default": "./dist/adapters/index.js"
      },
      "require": {
        "types": "./dist/adapters/index.d.ts",
        "default": "./dist/adapters/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "skills",
    "LICENSE"
  ],
  "keywords": [
    "tanstack-intent",
    "mock",
    "frontend",
    "tanstack-query",
    "prototype",
    "indexeddb",
    "json-server",
    "eristack"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@eristack/data-grid": "^0.2.0",
    "@eristack/doc-transitions": "^0.1.0",
    "@eristack/epoch": "^0.1.0",
    "@eristack/jwt-auth": "^0.4.0",
    "@eristack/pbac": "^0.2.0",
    "@eristack/qups": "^0.3.0",
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@eristack/data-grid": {
      "optional": true
    },
    "@eristack/doc-transitions": {
      "optional": true
    },
    "@eristack/epoch": {
      "optional": true
    },
    "@eristack/jwt-auth": {
      "optional": true
    },
    "@eristack/pbac": {
      "optional": true
    },
    "@eristack/qups": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/intent": "^0.3.6",
    "@tanstack/react-query": "^5.90.2",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.8",
    "react": "^19.1.0",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.10",
    "fake-indexeddb": "^6.0.0"
  },
  "license": "MIT"
}
