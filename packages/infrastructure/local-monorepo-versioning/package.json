{
  "name": "@eristack/local-monorepo-versioning",
  "version": "0.1.1",
  "description": "Headless version.lock.json bump math for private pnpm monorepos without Changesets or npm publish",
  "repository": {
    "type": "git",
    "url": "https://github.com/eristack/business-libs.git",
    "directory": "packages/infrastructure/local-monorepo-versioning"
  },
  "homepage": "https://github.com/eristack/business-libs/tree/main/packages/infrastructure/local-monorepo-versioning",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "eristack-version": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node/index.js"
      },
      "require": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "skills",
    "LICENSE"
  ],
  "keywords": [
    "tanstack-intent",
    "semver",
    "monorepo",
    "versioning",
    "eristack"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node ../../../scripts/chmod-bins.mjs dist/cli.js",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@tanstack/intent": "^0.3.6",
    "@types/node": "^22.15.29",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}
