{
  "name": "@eristack/id-wilayah",
  "version": "0.0.0",
  "description": "Indonesia official admin division codes — provinces through villages, unit kinds through hamlet, community block, and neighborhood",
  "repository": {
    "type": "git",
    "url": "https://github.com/eristack/business-libs.git",
    "directory": "packages/registries/id-wilayah"
  },
  "homepage": "https://github.com/eristack/business-libs/tree/main/packages/registries/id-wilayah",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./zod": {
      "import": {
        "types": "./dist/zod/index.d.ts",
        "default": "./dist/zod/index.js"
      },
      "require": {
        "types": "./dist/zod/index.d.ts",
        "default": "./dist/zod/index.cjs"
      }
    },
    "./bundled": {
      "import": {
        "types": "./dist/bundled/index.d.ts",
        "default": "./dist/bundled/index.js"
      },
      "require": {
        "types": "./dist/bundled/index.d.ts",
        "default": "./dist/bundled/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "skills",
    "LICENSE"
  ],
  "keywords": [
    "tanstack-intent",
    "indonesia",
    "wilayah",
    "kemendagri",
    "registries",
    "erp",
    "eristack"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && mkdir -p dist/bundled && cp src/bundled/official-registry-2024.json.gz dist/bundled/",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "sync:data": "node scripts/sync-bundled-data.mjs"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/intent": "^0.3.6",
    "@types/node": "^22.15.29",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.10",
    "zod": "^4.0.0"
  },
  "license": "MIT"
}
